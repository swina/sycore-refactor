{
  "name": "sycore-gen-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:refactor": "VITE_DEV_PORT=3999 VITE_DB_NAME=sycore_2 vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:website": "vite --mode website",
    "build:website": "vite build --mode website",
    "preview:website": "vite preview --mode website --outDir dist-site",
    "deploy:app": "vercel deploy --prod",
    "deploy:website": "npm run build:website && vercel link --cwd dist-site --project sycore-website --yes && vercel deploy --cwd dist-site --prod",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@tailwindcss/postcss": "^4.2.4",
    "@upstash/redis": "^1.38.0",
    "@vercel/kv": "^3.0.0",
    "freesound": "^0.0.4",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.4",
    "pinia": "^3.0.4",
    "tone": "^15.1.22",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4",
    "web-push": "^3.6.7",
    "webmidi": "^3.1.16"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.6",
    "midi-file": "^1.2.4",
    "postcss": "^8.5.14",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  }
}
